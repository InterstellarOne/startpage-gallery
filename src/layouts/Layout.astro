<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      href={`${import.meta.env.BASE_URL}favicon.ico`}
      sizes="any"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL}favicon.svg`}
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL}favicon-dark.svg`}
      media="(prefers-color-scheme: dark)"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content="Startpage Gallery" />
    <meta property="og:description" content="A place to discover and share browser startpages." />
    <meta name="title" content="Startpage Gallery" />
    <meta name="description" content="A place to discover and share browser startpages." />  
    <meta name="theme-color" content="#3584e4">
    <meta name="generator" content={Astro.generator} />
    <title>Startpage Gallery</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka&family=Quicksand:wght@300..700&display=swap"
      rel="stylesheet"
    />
  </head><body>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
</style>

<style>
  @import url(../styles/colors.css);
  html,
  body {
    font-family: "Quicksand", sans-serif;
    font-optical-sizing: auto;
    font-weight: 500;
    font-style: normal;
    font-variation-settings: "wdth" 100;
    background-color: var(--bg-primary);
    margin: 0 auto;
    padding: 0;
    width: 100%;
  }
</style>
